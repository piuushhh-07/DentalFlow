{
  "name": "dentalflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test src/features/auth/lib/*.test.ts src/features/onboarding/lib/*.test.ts src/features/patients/lib/*.test.ts src/features/treatments/lib/*.test.ts src/features/recalls/lib/*.test.ts src/features/follow-ups/lib/*.test.ts src/features/messages/lib/*.test.ts src/features/reports/lib/*.test.ts src/features/insurance/lib/*.test.ts src/features/demo/lib/*.test.ts scripts/integration-test.test.ts",
    "test:integration:diagnose": "tsx scripts/integration-test.ts diagnose",
    "test:integration:prepare": "tsx scripts/integration-test.ts prepare",
    "test:integration": "tsx scripts/integration-test.ts test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "6.19.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "6.19.2",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}

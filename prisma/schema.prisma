generator client {
  provider = "prisma-client-js"
}

enum ClinicInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model PatientDataExportAudit {
  id          String           @id @default(uuid()) @db.Uuid
  clinicId    String           @db.Uuid
  patientId   String           @db.Uuid
  actorUserId String           @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  clinic      Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient          @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  actor       ClinicMembership @relation(fields: [actorUserId, clinicId], references: [userId, clinicId], onDelete: Restrict)

  @@index([clinicId, patientId, createdAt])
  @@index([clinicId, actorUserId, createdAt])
  @@index([actorUserId, clinicId], map: "fk_e008c_actor_user_id_2c")
  @@index([patientId, clinicId], map: "fk_e008c_patient_id_2c")
  @@map("patient_data_export_audits")
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ClinicRole {
  OWNER
  STAFF
}

enum DentistWorkingStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum StaffJobTitle {
  DENTIST
  RECEPTIONIST
  DENTAL_ASSISTANT
  CLINIC_MANAGER
  BILLING_STAFF
}

enum ClinicPermission {
  PATIENT_VIEW
  PATIENT_EDIT
  APPOINTMENT_MANAGE
  CLINICAL_RECORDS
  PRESCRIPTIONS
  TREATMENT_PLANS
  FINANCIAL_RECORDS
  INSURANCE
  INVENTORY
  REPORTS
  STAFF_MANAGE
  CLINIC_SETTINGS
}

enum TreatmentType {
  ROOT_CANAL
  CROWN
  IMPLANT
  BRACES
  SCALING
  CUSTOM
}

enum TreatmentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TreatmentCatalogStatus {
  ACTIVE
  INACTIVE
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum FinancialEntryType {
  PAYMENT
  DISCOUNT
  REFUND
}

enum TreatmentEstimateStatus {

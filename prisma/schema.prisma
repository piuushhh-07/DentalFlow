generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ClinicRole {
  OWNER
  STAFF
}

enum TreatmentType {
  ROOT_CANAL
  CROWN
  IMPLANT
  BRACES
  SCALING
  CUSTOM
}

enum TreatmentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TreatmentCatalogStatus {
  ACTIVE
  INACTIVE
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum FinancialEntryType {
  PAYMENT
  DISCOUNT
  REFUND
}

enum TreatmentVisitStatus {
  PENDING
  REMINDER_SENT
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_RESPONSE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PreventiveRecallType {
  SIX_MONTH_CHECKUP
  CLEANING
  CUSTOM
}

enum PreventiveRecallStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum MessageChannel {
  WHATSAPP
}

enum MessageLogStatus {
  OPENED_IN_WHATSAPP
  MANUALLY_RECORDED_SENT
}

enum InsuranceProviderKind {
  INSURER
  TPA
  BOTH
}

enum InsuranceClaimType {
  CASHLESS
  REIMBURSEMENT
}

enum InsuranceClaimStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_DOCUMENTS
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PAID
  CLOSED
}

enum InsurancePreAuthorizationStatus {
  DRAFT
  SUBMITTED
  NEEDS_DOCUMENTS
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum InsuranceDocumentType {
  POLICY_COPY
  TREATMENT_ESTIMATE
  TREATMENT_PLAN
  CLAIM_FORM
  INVOICE
  PRESCRIPTION
  DIAGNOSTIC_REPORT
  DISCHARGE_SUMMARY
  OTHER
}

enum InsuranceDocumentStatus {
  REQUIRED
  RECEIVED
  VERIFIED
  REJECTED
}

enum InsuranceDocumentExtractionStatus {
  NOT_STARTED
  PROCESSING
  NEEDS_REVIEW
  FAILED
}

enum InsurancePaymentKind {
  PATIENT_PAYMENT
  INSURER_PAYMENT
}

enum InsuranceActivityType {
  CLAIM_CREATED
  STATUS_CHANGED
  CLAIM_UPDATED
  FOLLOW_UP_SCHEDULED
  PREAUTH_CREATED
  PREAUTH_STATUS_CHANGED
  DOCUMENT_REQUIRED
  DOCUMENT_RECEIVED
  DOCUMENT_VERIFIED
  DOCUMENT_REJECTED
  DOCUMENT_EXTRACTION_COMPLETED
  DOCUMENT_EXTRACTION_FAILED
  PAYMENT_RECORDED
  CLAIM_SUMMARY_UPDATED
  CLAIM_SUMMARY_REVIEWED
  POLICY_QUESTION_ANSWERED
  NOTE_ADDED
}

model UserProfile {
  id              String             @id @db.Uuid
  displayName     String?            @db.VarChar(120)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)
  memberships     ClinicMembership[]
  onboardedClinic Clinic?            @relation("ClinicOnboarding")

  @@map("user_profiles")
}

model Clinic {
  id                         String                      @id @default(uuid()) @db.Uuid
  name                       String                      @db.VarChar(160)
  phoneNumber                String?                     @db.VarChar(20)
  contactEmail               String?                     @db.VarChar(254)
  address                    String?                     @db.VarChar(400)
  timeZone                   String                      @default("Asia/Kolkata") @db.VarChar(64)
  onboardingUserId           String?                     @unique @db.Uuid
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz(6)
  onboardingUser             UserProfile?                @relation("ClinicOnboarding", fields: [onboardingUserId], references: [id], onDelete: SetNull)
  memberships                ClinicMembership[]
  patients                   Patient[]
  treatmentPlans             TreatmentPlan[]
  treatmentCatalogueItems    TreatmentCatalogueItem[]
  treatmentFinancialEntries  TreatmentFinancialEntry[]
  treatmentVisits            TreatmentVisit[]
  appointments               Appointment[]
  preventiveRecalls          PreventiveRecall[]
  messageTemplates           MessageTemplate[]
  messageLogs                MessageLog[]
  insuranceProviders         InsuranceProvider[]
  insurancePolicies          InsurancePolicy[]
  insuranceClaims            InsuranceClaim[]
  insurancePreAuthorizations InsurancePreAuthorization[]
  insuranceDocuments         InsuranceDocument[]
  insurancePayments          InsurancePayment[]
  insuranceActivities        InsuranceActivity[]

  @@index([name])
  @@map("clinics")
}

model ClinicMembership {
  id                  String                    @id @default(uuid()) @db.Uuid
  clinicId            String                    @db.Uuid
  userId              String                    @db.Uuid
  role                ClinicRole
  createdAt           DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(6)
  clinic              Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user                UserProfile               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageLogs         MessageLog[]              @relation("MessageSender")
  financialEntries    TreatmentFinancialEntry[] @relation("TreatmentFinancialEntryActor")
  insurancePayments   InsurancePayment[]
  insuranceActivities InsuranceActivity[]
  reviewedInsuranceClaimSummaries InsuranceClaim[] @relation("InsuranceClaimSummaryReviewer")

  @@unique([userId, clinicId])
  @@index([clinicId, role])
  @@map("clinic_memberships")
}

model Patient {
  id                         String                      @id @default(uuid()) @db.Uuid
  clinicId                   String                      @db.Uuid
  fullName                   String                      @db.VarChar(160)
  phoneNumber                String                      @db.VarChar(20)
  normalizedPhone            String                      @db.VarChar(16)
  whatsappOptIn              Boolean                     @default(false)
  whatsappOptedInAt          DateTime?                   @db.Timestamptz(6)
  notes                      String?                     @db.Text
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz(6)
  clinic                     Clinic                      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  treatmentPlans             TreatmentPlan[]
  treatmentFinancialEntries  TreatmentFinancialEntry[]
  appointments               Appointment[]
  preventiveRecalls          PreventiveRecall[]
  messageLogs                MessageLog[]
  insurancePolicies          InsurancePolicy[]
  insuranceClaims            InsuranceClaim[]
  insurancePreAuthorizations InsurancePreAuthorization[]

  @@unique([id, clinicId])
  @@unique([clinicId, normalizedPhone])
  @@index([clinicId, fullName])
  @@map("patients")
}

model TreatmentPlan {
  id                         String                      @id @default(uuid()) @db.Uuid
  clinicId                   String                      @db.Uuid
  patientId                  String                      @db.Uuid
  catalogItemId              String?                     @db.Uuid
  name                       String                      @db.VarChar(160)
  type                       TreatmentType
  status                     TreatmentPlanStatus         @default(ACTIVE)
  totalVisits                Int                         @default(1)
  estimatedAmount            Decimal?                    @db.Decimal(12, 2)
  finalAmount                Decimal?                    @db.Decimal(12, 2)
  discountAmount             Decimal?                    @db.Decimal(12, 2)
  currency                   String                      @default("INR") @db.VarChar(16)
  completedAt                DateTime?                   @db.Timestamptz(6)
  notes                      String?                     @db.Text
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz(6)
  clinic                     Clinic                      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient                    Patient                     @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Cascade)
  catalogItem                TreatmentCatalogueItem?     @relation(fields: [catalogItemId, clinicId], references: [id, clinicId], onDelete: Restrict)
  visits                     TreatmentVisit[]
  financialEntries           TreatmentFinancialEntry[]
  insuranceClaims            InsuranceClaim[]
  insurancePreAuthorizations InsurancePreAuthorization[]

  @@unique([id, clinicId])
  @@unique([id, clinicId, patientId])
  @@index([clinicId, status, completedAt])
  @@index([clinicId, patientId])
  @@map("treatment_plans")
}

model TreatmentCatalogueItem {
  id             String                 @id @default(uuid()) @db.Uuid
  clinicId       String                 @db.Uuid
  name           String                 @db.VarChar(160)
  description    String?                @db.Text
  defaultPrice   Decimal?               @db.Decimal(12, 2)
  status         TreatmentCatalogStatus @default(ACTIVE)
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(6)
  clinic         Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  treatmentPlans TreatmentPlan[]

  @@unique([id, clinicId])
  @@unique([clinicId, name])
  @@index([clinicId, status, name])
  @@map("treatment_catalogue_items")
}

model TreatmentFinancialEntry {
  id              String             @id @default(uuid()) @db.Uuid
  clinicId        String             @db.Uuid
  patientId       String             @db.Uuid
  treatmentPlanId String             @db.Uuid
  createdByUserId String             @db.Uuid
  entryType       FinancialEntryType
  paymentMethod   PaymentMethod?
  amount          Decimal            @db.Decimal(12, 2)
  balanceAfter    Decimal?           @db.Decimal(12, 2)
  reference       String?            @db.VarChar(120)
  notes           String?            @db.Text
  receiptNumber   String?            @db.VarChar(40)
  requestKey      String             @default(uuid()) @db.Uuid
  requestHash     String             @db.VarChar(64)
  paidAt          DateTime           @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  clinic          Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient            @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  treatmentPlan   TreatmentPlan      @relation(fields: [treatmentPlanId, clinicId], references: [id, clinicId], onDelete: Cascade)
  createdBy       ClinicMembership   @relation("TreatmentFinancialEntryActor", fields: [createdByUserId, clinicId], references: [userId, clinicId], onDelete: Restrict)

  @@unique([id, clinicId])
  @@unique([clinicId, requestKey])
  @@unique([clinicId, receiptNumber])
  @@index([clinicId, treatmentPlanId, paidAt])
  @@index([clinicId, patientId, paidAt])
  @@map("treatment_financial_entries")
}

model TreatmentVisit {
  id              String               @id @default(uuid()) @db.Uuid
  clinicId        String               @db.Uuid
  treatmentPlanId String               @db.Uuid
  patientId       String               @db.Uuid
  visitNumber     Int
  dueDate         DateTime             @db.Date
  status          TreatmentVisitStatus @default(PENDING)
  completedAt     DateTime?            @db.Timestamptz(6)
  notes           String?              @db.Text
  createdAt       DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(6)
  clinic          Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  treatmentPlan   TreatmentPlan        @relation(fields: [treatmentPlanId, clinicId, patientId], references: [id, clinicId, patientId], onDelete: Cascade)
  messageLogs     MessageLog[]
  appointments    Appointment[]

  @@unique([id, clinicId])
  @@unique([id, clinicId, patientId])
  @@unique([treatmentPlanId, visitNumber])
  @@index([clinicId, status, dueDate])
  @@index([clinicId, dueDate])
  @@map("treatment_visits")
}

model Appointment {
  id               String            @id @default(uuid()) @db.Uuid
  clinicId         String            @db.Uuid
  patientId        String            @db.Uuid
  treatmentVisitId String?           @db.Uuid
  scheduledAt      DateTime          @db.Timestamptz(6)
  durationMinutes  Int
  dentistName      String            @db.VarChar(120)
  chairLabel       String            @db.VarChar(80)
  type             String            @db.VarChar(160)
  status           AppointmentStatus @default(SCHEDULED)
  notes            String?           @db.Text
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)
  clinic           Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient          Patient           @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Cascade)
  treatmentVisit   TreatmentVisit?   @relation(fields: [treatmentVisitId, clinicId, patientId], references: [id, clinicId, patientId], onDelete: Restrict)

  @@unique([id, clinicId])
  @@index([clinicId, scheduledAt, status])
  @@index([clinicId, patientId, scheduledAt])
  @@index([clinicId, treatmentVisitId])
  @@map("appointments")
}

model PreventiveRecall {
  id             String                 @id @default(uuid()) @db.Uuid
  clinicId       String                 @db.Uuid
  patientId      String                 @db.Uuid
  type           PreventiveRecallType
  customName     String?                @db.VarChar(160)
  intervalMonths Int?
  dueDate        DateTime               @db.Date
  status         PreventiveRecallStatus @default(ACTIVE)
  completedAt    DateTime?              @db.Timestamptz(6)
  notes          String?                @db.Text
  createdAt      DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(6)
  clinic         Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient        Patient                @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Cascade)
  messageLogs    MessageLog[]

  @@unique([id, clinicId])
  @@unique([id, clinicId, patientId])
  @@index([clinicId, status, dueDate])
  @@index([clinicId, patientId])
  @@map("preventive_recalls")
}

model MessageTemplate {
  id          String       @id @default(uuid()) @db.Uuid
  clinicId    String       @db.Uuid
  name        String       @db.VarChar(120)
  content     String       @db.Text
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  clinic      Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  messageLogs MessageLog[]

  @@unique([id, clinicId])
  @@unique([clinicId, name])
  @@index([clinicId, isActive])
  @@map("message_templates")
}

model MessageLog {
  id                      String            @id @default(uuid()) @db.Uuid
  clinicId                String            @db.Uuid
  patientId               String            @db.Uuid
  treatmentVisitId        String?           @db.Uuid
  preventiveRecallId      String?           @db.Uuid
  messageTemplateId       String?           @db.Uuid
  senderUserId            String            @db.Uuid
  channel                 MessageChannel    @default(WHATSAPP)
  status                  MessageLogStatus  @default(OPENED_IN_WHATSAPP)
  recipientPhoneSnapshot  String            @db.VarChar(20)
  templateNameSnapshot    String?           @db.VarChar(120)
  messageSnapshot         String            @db.Text
  openedAt                DateTime?         @db.Timestamptz(6)
  clientRequestId         String?           @db.Uuid
  manuallyConfirmedSentAt DateTime?         @db.Timestamptz(6)
  createdAt               DateTime          @default(now()) @db.Timestamptz(6)
  clinic                  Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient                 Patient           @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  treatmentVisit          TreatmentVisit?   @relation(fields: [treatmentVisitId, clinicId, patientId], references: [id, clinicId, patientId], onDelete: Restrict)
  preventiveRecall        PreventiveRecall? @relation(fields: [preventiveRecallId, clinicId, patientId], references: [id, clinicId, patientId], onDelete: Restrict)
  messageTemplate         MessageTemplate?  @relation(fields: [messageTemplateId, clinicId], references: [id, clinicId], onDelete: Restrict)
  sender                  ClinicMembership  @relation("MessageSender", fields: [senderUserId, clinicId], references: [userId, clinicId], onDelete: Restrict)

  @@unique([clinicId, clientRequestId])
  @@index([clinicId, openedAt])
  @@index([clinicId, patientId, openedAt])
  @@index([clinicId, senderUserId, openedAt])
  @@index([clinicId, preventiveRecallId])
  @@index([clinicId, status, manuallyConfirmedSentAt])
  @@map("message_logs")
}

model InsuranceProvider {
  id                String                @id @default(uuid()) @db.Uuid
  clinicId          String                @db.Uuid
  name              String                @db.VarChar(180)
  kind              InsuranceProviderKind
  phoneNumber       String?               @db.VarChar(20)
  email             String?               @db.VarChar(254)
  website           String?               @db.VarChar(400)
  claimInstructions String?               @db.Text
  notes             String?               @db.Text
  archivedAt        DateTime?             @db.Timestamptz(6)
  createdAt         DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(6)
  clinic            Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  policies          InsurancePolicy[]
  activities        InsuranceActivity[]

  @@unique([id, clinicId])
  @@unique([clinicId, name])
  @@index([clinicId, archivedAt, name])
  @@map("insurance_providers")
}

model InsurancePolicy {
  id                String                      @id @default(uuid()) @db.Uuid
  clinicId          String                      @db.Uuid
  patientId         String                      @db.Uuid
  providerId        String                      @db.Uuid
  policyNumber      String                      @db.VarChar(120)
  memberReference   String?                     @db.VarChar(120)
  validFrom         DateTime                    @db.Date
  validUntil        DateTime                    @db.Date
  coverageLimit     Decimal?                    @db.Decimal(12, 2)
  deductible        Decimal?                    @db.Decimal(12, 2)
  coPaymentPercent  Decimal?                    @db.Decimal(5, 2)
  exclusions        String?                     @db.Text
  coverageNotes     String?                     @db.Text
  createdAt         DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                    @updatedAt @db.Timestamptz(6)
  clinic            Clinic                      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient           Patient                     @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Cascade)
  provider          InsuranceProvider           @relation(fields: [providerId, clinicId], references: [id, clinicId], onDelete: Restrict)
  claims            InsuranceClaim[]
  preAuthorizations InsurancePreAuthorization[]
  activities        InsuranceActivity[]

  @@unique([id, clinicId])
  @@unique([id, clinicId, patientId])
  @@index([clinicId, patientId, validUntil])
  @@index([clinicId, providerId])
  @@map("insurance_policies")
}

model InsuranceClaim {
  id                 String                     @id @default(uuid()) @db.Uuid
  clinicId           String                     @db.Uuid
  patientId          String                     @db.Uuid
  policyId           String                     @db.Uuid
  treatmentPlanId    String?                    @db.Uuid
  preAuthorizationId String?                    @unique @db.Uuid
  type               InsuranceClaimType
  status             InsuranceClaimStatus       @default(DRAFT)
  treatmentDetails   String                     @db.VarChar(2000)
  treatmentDate      DateTime                   @db.Date
  estimatedCost      Decimal                    @db.Decimal(12, 2)
  amountClaimed      Decimal                    @db.Decimal(12, 2)
  amountApproved     Decimal?                   @db.Decimal(12, 2)
  claimReference     String?                    @db.VarChar(120)
  submittedAt        DateTime?                  @db.Timestamptz(6)
  insurerRespondedAt DateTime?                  @db.Timestamptz(6)
  followUpAt         DateTime?                  @db.Timestamptz(6)
  rejectionReason    String?                    @db.Text
  notes              String?                    @db.Text
  claimSummary       String?                    @db.Text
  claimSummaryFields Json?                       @db.JsonB
  claimSummarySources Json?                      @db.JsonB
  summaryReviewedAt  DateTime?                  @db.Timestamptz(6)
  summaryReviewedById String?                   @db.Uuid
  resubmissionCount  Int                        @default(0)
  createdAt          DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(6)
  clinic             Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient            Patient                    @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  policy             InsurancePolicy            @relation(fields: [policyId, clinicId, patientId], references: [id, clinicId, patientId], onDelete: Restrict)
  treatmentPlan      TreatmentPlan?             @relation(fields: [treatmentPlanId, clinicId, patientId], references: [id, clinicId, patientId], onDelete: Restrict)
  preAuthorization   InsurancePreAuthorization? @relation(fields: [preAuthorizationId, clinicId, patientId], references: [id, clinicId, patientId], onDelete: Restrict)
  summaryReviewer    ClinicMembership?          @relation("InsuranceClaimSummaryReviewer", fields: [summaryReviewedById, clinicId], references: [userId, clinicId], onDelete: Restrict)
  payments           InsurancePayment[]
  documents          InsuranceDocument[]
  activities         InsuranceActivity[]

  @@unique([id, clinicId])
  @@unique([id, clinicId, patientId])
  @@unique([preAuthorizationId, clinicId, patientId])
  @@index([clinicId, status, createdAt])
  @@index([clinicId, type, status])
  @@index([clinicId, followUpAt])
  @@index([clinicId, patientId, createdAt])
  @@map("insurance_claims")
}

model InsurancePreAuthorization {
  id                String                          @id @default(uuid()) @db.Uuid
  clinicId          String                          @db.Uuid
  patientId         String                          @db.Uuid
  policyId          String                          @db.Uuid
  treatmentPlanId   String?                         @db.Uuid
  status            InsurancePreAuthorizationStatus @default(DRAFT)
  proposedTreatment String                          @db.VarChar(2000)
  estimatedCost     Decimal                         @db.Decimal(12, 2)
  requestReference  String?                         @db.VarChar(120)
  submittedAt       DateTime?                       @db.Timestamptz(6)
  decidedAt         DateTime?                       @db.Timestamptz(6)
  approvedAmount    Decimal?                        @db.Decimal(12, 2)
  conditions        String?                         @db.Text
  expiresAt         DateTime?                       @db.Timestamptz(6)
  rejectionReason   String?                         @db.Text
  createdAt         DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                        @updatedAt @db.Timestamptz(6)
  clinic            Clinic                          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient           Patient                         @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  policy            InsurancePolicy                 @relation(fields: [policyId, clinicId, patientId], references: [id, clinicId, patientId], onDelete: Restrict)
  treatmentPlan     TreatmentPlan?                  @relation(fields: [treatmentPlanId, clinicId, patientId], references: [id, clinicId, patientId], onDelete: Restrict)
  claim             InsuranceClaim?
  activities        InsuranceActivity[]

  @@unique([id, clinicId, patientId])
  @@unique([id, clinicId])
  @@index([clinicId, status, createdAt])
  @@index([clinicId, expiresAt])
  @@map("insurance_pre_authorizations")
}

model InsurancePayment {
  id           String               @id @default(uuid()) @db.Uuid
  clinicId     String               @db.Uuid
  claimId      String               @db.Uuid
  recordedById String               @db.Uuid
  kind         InsurancePaymentKind
  amount       Decimal              @db.Decimal(12, 2)
  paidAt       DateTime             @db.Timestamptz(6)
  reference    String?              @db.VarChar(120)
  notes        String?              @db.Text
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  clinic       Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  claim        InsuranceClaim       @relation(fields: [claimId, clinicId], references: [id, clinicId], onDelete: Restrict)
  recordedBy   ClinicMembership     @relation(fields: [recordedById, clinicId], references: [userId, clinicId], onDelete: Restrict)

  @@index([clinicId, claimId, kind, paidAt])
  @@map("insurance_payments")
}

model InsuranceDocument {
  id              String                  @id @default(uuid()) @db.Uuid
  clinicId        String                  @db.Uuid
  claimId         String                  @db.Uuid
  type            InsuranceDocumentType
  name            String                  @db.VarChar(160)
  status          InsuranceDocumentStatus @default(REQUIRED)
  storagePath     String?                 @unique @db.VarChar(500)
  receivedAt      DateTime?               @db.Timestamptz(6)
  verifiedAt      DateTime?               @db.Timestamptz(6)
  rejectionReason String?                 @db.Text
  extractionStatus InsuranceDocumentExtractionStatus @default(NOT_STARTED)
  extractionData  Json?                   @db.JsonB
  extractionIssues Json?                  @db.JsonB
  extractionCompletedAt DateTime?         @db.Timestamptz(6)
  extractionModel String?                 @db.VarChar(120)
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(6)
  clinic          Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  claim           InsuranceClaim          @relation(fields: [claimId, clinicId], references: [id, clinicId], onDelete: Restrict)

  @@unique([id, clinicId, claimId])
  @@index([clinicId, claimId, status])
  @@index([clinicId, extractionStatus])
  @@map("insurance_documents")
}

model InsuranceActivity {
  id                 String                     @id @default(uuid()) @db.Uuid
  clinicId           String                     @db.Uuid
  claimId            String?                    @db.Uuid
  preAuthorizationId String?                    @db.Uuid
  policyId           String?                    @db.Uuid
  providerId         String?                    @db.Uuid
  actorUserId        String                     @db.Uuid
  type               InsuranceActivityType
  summary            String                     @db.VarChar(240)
  details            Json?                      @db.JsonB
  createdAt          DateTime                   @default(now()) @db.Timestamptz(6)
  clinic             Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  claim              InsuranceClaim?            @relation(fields: [claimId, clinicId], references: [id, clinicId], onDelete: Restrict)
  preAuthorization   InsurancePreAuthorization? @relation(fields: [preAuthorizationId, clinicId], references: [id, clinicId], onDelete: Restrict)
  policy             InsurancePolicy?            @relation(fields: [policyId, clinicId], references: [id, clinicId], onDelete: Restrict)
  provider           InsuranceProvider?          @relation(fields: [providerId, clinicId], references: [id, clinicId], onDelete: Restrict)
  actor              ClinicMembership           @relation(fields: [actorUserId, clinicId], references: [userId, clinicId], onDelete: Restrict)

  @@index([clinicId, claimId, createdAt])
  @@index([clinicId, preAuthorizationId, createdAt])
  @@index([clinicId, policyId, createdAt])
  @@index([clinicId, providerId, createdAt])
  @@map("insurance_activities")
}

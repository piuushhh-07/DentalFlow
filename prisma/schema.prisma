  DOCUMENT_EXTRACTION_FAILED
  PAYMENT_RECORDED
  CLAIM_SUMMARY_UPDATED
  CLAIM_SUMMARY_REVIEWED
  POLICY_QUESTION_ANSWERED
  NOTE_ADDED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum BillingSubscriptionStatus {
  CHECKOUT_PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  CANCEL_AT_PERIOD_END
  PAUSED
  CANCELLED
  EXPIRED
  FAILED
}

enum BillingPaymentStatus {
  SUCCEEDED
  FAILED
  REFUNDED
}

enum BillingWebhookStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model UserProfile {
  id              String             @id @db.Uuid
  displayName     String?            @db.VarChar(120)
  email           String?            @db.VarChar(254)
  normalizedEmail String?            @unique @db.VarChar(254)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)
  memberships     ClinicMembership[]
  onboardedClinic Clinic?            @relation("ClinicOnboarding")

  @@map("user_profiles")
}

model Clinic {
  id                                 String                              @id @default(uuid()) @db.Uuid
  name                               String                              @db.VarChar(160)
  publicBookingSlug                  String                              @unique @db.VarChar(180)
  publicBookingEnabled               Boolean                             @default(false)
  automatedWhatsAppEnabled           Boolean                             @default(false)
  phoneNumber                        String?                             @db.VarChar(20)
  contactEmail                       String?                             @db.VarChar(254)
  address                            String?                             @db.VarChar(400)
  timeZone                           String                              @default("Asia/Kolkata") @db.VarChar(64)
  workingHours                       Json                                @default("[]") @db.JsonB
  onboardingUserId                   String?                             @unique @db.Uuid
  createdAt                          DateTime                            @default(now()) @db.Timestamptz(6)
  updatedAt                          DateTime                            @updatedAt @db.Timestamptz(6)
  onboardingUser                     UserProfile?                        @relation("ClinicOnboarding", fields: [onboardingUserId], references: [id], onDelete: SetNull)
  memberships                        ClinicMembership[]
  patients                           Patient[]
  treatmentPlans                     TreatmentPlan[]
  treatmentCatalogueItems            TreatmentCatalogueItem[]
  treatmentFinancialEntries          TreatmentFinancialEntry[]
  treatmentEstimates                 TreatmentEstimate[]
  treatmentVisits                    TreatmentVisit[]
  appointments                       Appointment[]
  dentists                           ClinicDentist[]
  treatmentChairs                    TreatmentChair[]
  appointmentRequests                AppointmentRequest[]
  invitations                        ClinicInvitation[]
  preventiveRecalls                  PreventiveRecall[]
  messageTemplates                   MessageTemplate[]
  messageLogs                        MessageLog[]
  insuranceProviders                 InsuranceProvider[]
  insurancePolicies                  InsurancePolicy[]
  insuranceClaims                    InsuranceClaim[]
  insurancePreAuthorizations         InsurancePreAuthorization[]
  insuranceDocuments                 InsuranceDocument[]
  insurancePayments                  InsurancePayment[]
  insuranceActivities                InsuranceActivity[]
  billingSubscriptions               ClinicSubscription[]
  billingPayments                    BillingPayment[]
  odontogramEntries                  OdontogramEntry[]
  dentalClinicalRecords              DentalClinicalRecord[]
  digitalPrescriptions               DigitalPrescription[]
  prescriptionMedicineCatalogueItems PrescriptionMedicineCatalogueItem[]
  patientDataExportAudits            PatientDataExportAudit[]
  inventoryItems                      InventoryItem[]
  inventoryTransactions                InventoryTransaction[]
  expenses                             ClinicExpense[]

  @@index([name])
  @@map("clinics")
}

model BillingPlanVersion {
  id                 String               @id @default(uuid()) @db.Uuid
  code               String               @db.VarChar(64)
  version            Int
  displayName        String               @db.VarChar(120)
  description        String?              @db.VarChar(500)
  currency           String               @default("INR") @db.VarChar(3)
  amountMinor        Int
  interval           BillingInterval
  intervalCount      Int                  @default(1)
  totalBillingCycles Int
  trialDays          Int                  @default(14)
  graceDays          Int                  @default(7)
  entitlements       Json                 @db.JsonB
  providerPlanId     String?              @unique @db.VarChar(64)
  availableForSale   Boolean              @default(false)
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @db.Timestamptz(6)
  subscriptions      ClinicSubscription[]

  @@unique([code, version])
  @@index([availableForSale, code])
  @@map("billing_plan_versions")
}

model ClinicSubscription {
  id                         String                    @id @default(uuid()) @db.Uuid
  clinicId                   String                    @db.Uuid
  planVersionId              String                    @db.Uuid
  status                     BillingSubscriptionStatus @default(CHECKOUT_PENDING)
  providerSubscriptionId     String?                   @unique @db.VarChar(64)
  providerCustomerId         String?                   @db.VarChar(64)
  checkoutUrl                String?                   @db.VarChar(500)
  checkoutExpiresAt          DateTime?                 @db.Timestamptz(6)
  trialStartedAt             DateTime?                 @db.Timestamptz(6)
  trialEndsAt                DateTime?                 @db.Timestamptz(6)
  currentPeriodStart         DateTime?                 @db.Timestamptz(6)
  currentPeriodEnd           DateTime?                 @db.Timestamptz(6)
  graceUntil                 DateTime?                 @db.Timestamptz(6)
  cancelAtPeriodEnd          Boolean                   @default(false)
  cancelledAt                DateTime?                 @db.Timestamptz(6)
  lastProviderEventCreatedAt DateTime?                 @db.Timestamptz(6)
  createdAt                  DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                  @updatedAt @db.Timestamptz(6)
  clinic                     Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  planVersion                BillingPlanVersion        @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  payments                   BillingPayment[]

  @@unique([id, clinicId])
  @@index([clinicId, status, createdAt])
  @@index([planVersionId], map: "cs_plan_version_idx")
  @@map("clinic_subscriptions")
}

model BillingPayment {
  id                String               @id @default(uuid()) @db.Uuid
  clinicId          String               @db.Uuid
  subscriptionId    String               @db.Uuid
  providerPaymentId String               @unique @db.VarChar(64)
  providerInvoiceId String?              @db.VarChar(64)
  amountMinor       Int
  currency          String               @db.VarChar(3)
  status            BillingPaymentStatus
  failureCode       String?              @db.VarChar(120)
  paidAt            DateTime?            @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  clinic            Clinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  subscription      ClinicSubscription   @relation(fields: [subscriptionId, clinicId], references: [id, clinicId], onDelete: Cascade)

  @@unique([providerPaymentId, clinicId])
  @@index([clinicId, createdAt])
  @@index([subscriptionId, createdAt])
  @@index([clinicId, subscriptionId], map: "bp_subscription_clinic_idx")
  @@index([subscriptionId, clinicId], map: "fk_11vrt_subscription_id_2c")
  @@map("billing_payments")
}

model BillingWebhookEvent {
  id                  String               @id @default(uuid()) @db.Uuid
  providerEventId     String               @unique @db.VarChar(120)
  eventType           String               @db.VarChar(120)
  eventCreatedAt      DateTime             @db.Timestamptz(6)
  payload             Json                 @db.JsonB
  status              BillingWebhookStatus @default(PENDING)
  attemptCount        Int                  @default(0)
  processingStartedAt DateTime?            @db.Timestamptz(6)
  processedAt         DateTime?            @db.Timestamptz(6)
  lastError           String?              @db.VarChar(500)
  receivedAt          DateTime             @default(now()) @db.Timestamptz(6)

  @@index([status, receivedAt])
  @@index([eventType, eventCreatedAt])
  @@map("billing_webhook_events")
}

model ClinicMembership {
  id                                String                              @id @default(uuid()) @db.Uuid
  clinicId                          String                              @db.Uuid
  userId                            String                              @db.Uuid
  role                              ClinicRole
  active                            Boolean                             @default(true)
  permissionsConfigured             Boolean                             @default(false)
  createdAt                         DateTime                            @default(now()) @db.Timestamptz(6)
  updatedAt                         DateTime                            @updatedAt @db.Timestamptz(6)
  revokedAt                         DateTime?                           @db.Timestamptz(6)
  clinic                            Clinic                              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user                              UserProfile                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageLogs                       MessageLog[]                        @relation("MessageSender")
  financialEntries                  TreatmentFinancialEntry[]           @relation("TreatmentFinancialEntryActor")
  insurancePayments                 InsurancePayment[]
  insuranceActivities               InsuranceActivity[]
  reviewedInsuranceClaimSummaries   InsuranceClaim[]                    @relation("InsuranceClaimSummaryReviewer")
  recordedOdontogramEntries         OdontogramEntry[]
  dentalClinicalRecords             DentalClinicalRecord[]
  dentalClinicalRecordAudits        DentalClinicalRecordAudit[]
  authoredPrescriptions             DigitalPrescription[]               @relation("PrescriptionAuthor")
  createdPrescriptionCatalogueItems PrescriptionMedicineCatalogueItem[]
  prescriptionAudits                DigitalPrescriptionAudit[]
  authoredTreatmentEstimates        TreatmentEstimate[]                 @relation("TreatmentEstimateAuthor")
  treatmentEstimateAudits           TreatmentEstimateAudit[]
  patientDataExportAudits           PatientDataExportAudit[]
  inventoryTransactions             InventoryTransaction[]
  recordedExpenses                  ClinicExpense[]
  sentClinicInvitations             ClinicInvitation[]                  @relation("ClinicInvitationSender")
  staffProfile                      ClinicStaffProfile?
  permissionGrants                  ClinicPermissionGrant[]
  permissionChangesAuthored         ClinicStaffAudit[]                  @relation("ClinicStaffAuditActor")
  permissionChangesTargeted         ClinicStaffAudit[]                  @relation("ClinicStaffAuditTarget")

  @@unique([userId, clinicId])
  @@index([clinicId, role])
  @@index([clinicId, revokedAt, role])
  @@map("clinic_memberships")
}

model ClinicInvitation {
  id              String                 @id @default(uuid()) @db.Uuid
  clinicId        String                 @db.Uuid
  email           String                 @db.VarChar(254)
  normalizedEmail String                 @db.VarChar(254)
  role            ClinicRole             @default(STAFF)
  jobTitle        StaffJobTitle          @default(RECEPTIONIST)
  status          ClinicInvitationStatus @default(PENDING)
  invitedByUserId String                 @db.Uuid
  expiresAt       DateTime               @db.Timestamptz(6)
  acceptedAt      DateTime?              @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(6)
  clinic          Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  invitedBy       ClinicMembership       @relation("ClinicInvitationSender", fields: [invitedByUserId, clinicId], references: [userId, clinicId], onDelete: Restrict)

  @@index([clinicId, status, expiresAt])
  @@index([normalizedEmail, status, expiresAt])
  @@index([clinicId, invitedByUserId], map: "ci_inviter_clinic_idx")
  @@index([invitedByUserId, clinicId], map: "fk_1adgo_invited_by_user_id_2c")
  @@map("clinic_invitations")
}

model Patient {
  id                         String                      @id @default(uuid()) @db.Uuid
  clinicId                   String                      @db.Uuid
  fullName                   String                      @db.VarChar(160)
  phoneNumber                String                      @db.VarChar(20)
  normalizedPhone            String                      @db.VarChar(16)
  email                      String?                     @db.VarChar(254)
  normalizedEmail            String?                     @db.VarChar(254)
  portalAccessEnabled        Boolean                     @default(false)
  portalAccessEnabledAt      DateTime?                   @db.Timestamptz(6)
  whatsappOptIn              Boolean                     @default(false)
  whatsappOptedInAt          DateTime?                   @db.Timestamptz(6)
  notes                      String?                     @db.Text
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz(6)
  clinic                     Clinic                      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  treatmentPlans             TreatmentPlan[]
  treatmentFinancialEntries  TreatmentFinancialEntry[]
  treatmentEstimates         TreatmentEstimate[]
  appointments               Appointment[]
  preventiveRecalls          PreventiveRecall[]
  messageLogs                MessageLog[]
  insurancePolicies          InsurancePolicy[]
  insuranceClaims            InsuranceClaim[]
  insurancePreAuthorizations InsurancePreAuthorization[]
  odontogramEntries          OdontogramEntry[]
  dentalClinicalRecords      DentalClinicalRecord[]
  digitalPrescriptions       DigitalPrescription[]
  dataExportAudits           PatientDataExportAudit[]

  @@unique([id, clinicId])
  @@unique([clinicId, normalizedPhone])
  @@unique([clinicId, normalizedEmail])
  @@index([clinicId, fullName])
  @@map("patients")
}

model TreatmentPlan {
  id                         String                      @id @default(uuid()) @db.Uuid
  clinicId                   String                      @db.Uuid
  patientId                  String                      @db.Uuid
  catalogItemId              String?                     @db.Uuid
  name                       String                      @db.VarChar(160)
  type                       TreatmentType
  status                     TreatmentPlanStatus         @default(ACTIVE)
  totalVisits                Int                         @default(1)
  estimatedAmount            Decimal?                    @db.Decimal(12, 2)
  finalAmount                Decimal?                    @db.Decimal(12, 2)
  discountAmount             Decimal?                    @db.Decimal(12, 2)
  currency                   String                      @default("INR") @db.VarChar(16)
  completedAt                DateTime?                   @db.Timestamptz(6)
  notes                      String?                     @db.Text
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz(6)
  clinic                     Clinic                      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient                    Patient                     @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Cascade)
  catalogItem                TreatmentCatalogueItem?     @relation(fields: [catalogItemId, clinicId], references: [id, clinicId], onDelete: Restrict)
  visits                     TreatmentVisit[]
  financialEntries           TreatmentFinancialEntry[]
  estimates                  TreatmentEstimate[]
  insuranceClaims            InsuranceClaim[]
  insurancePreAuthorizations InsurancePreAuthorization[]
  odontogramEntries          OdontogramEntry[]

  @@unique([id, clinicId])
  @@unique([id, clinicId, patientId])
  @@index([clinicId, status, completedAt])
  @@index([clinicId, patientId])
  @@index([clinicId, catalogItemId], map: "tp_catalog_clinic_idx")
  @@index([catalogItemId, clinicId], map: "fk_bm4b1_catalog_item_id_2c")
  @@index([patientId, clinicId], map: "fk_bm4b1_patient_id_2c")
  @@map("treatment_plans")
}

model TreatmentCatalogueItem {
  id             String                  @id @default(uuid()) @db.Uuid
  clinicId       String                  @db.Uuid
  name           String                  @db.VarChar(160)
  description    String?                 @db.Text
  defaultPrice   Decimal?                @db.Decimal(12, 2)
  status         TreatmentCatalogStatus  @default(ACTIVE)
  createdAt      DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(6)
  clinic         Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  treatmentPlans TreatmentPlan[]
  estimateLines  TreatmentEstimateLine[]

  @@unique([id, clinicId])
  @@unique([clinicId, name])
  @@index([clinicId, status, name])
  @@map("treatment_catalogue_items")
}

model TreatmentFinancialEntry {
  id              String             @id @default(uuid()) @db.Uuid
  clinicId        String             @db.Uuid
  patientId       String             @db.Uuid
  treatmentPlanId String             @db.Uuid
  createdByUserId String             @db.Uuid
  entryType       FinancialEntryType
  paymentMethod   PaymentMethod?
  amount          Decimal            @db.Decimal(12, 2)
  balanceAfter    Decimal?           @db.Decimal(12, 2)
  reference       String?            @db.VarChar(120)
  notes           String?            @db.Text
  receiptNumber   String?            @db.VarChar(40)
  requestKey      String             @default(uuid()) @db.Uuid
  requestHash     String             @db.VarChar(64)
  paidAt          DateTime           @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  clinic          Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient         Patient            @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  treatmentPlan   TreatmentPlan      @relation(fields: [treatmentPlanId, clinicId], references: [id, clinicId], onDelete: Cascade)
  createdBy       ClinicMembership   @relation("TreatmentFinancialEntryActor", fields: [createdByUserId, clinicId], references: [userId, clinicId], onDelete: Restrict)

  @@unique([id, clinicId])
  @@unique([clinicId, requestKey])
  @@unique([clinicId, receiptNumber])
  @@index([clinicId, treatmentPlanId, paidAt])
  @@index([clinicId, patientId, paidAt])
  @@index([clinicId, createdByUserId], map: "tfe_creator_clinic_idx")
  @@index([createdByUserId, clinicId], map: "fk_1gdvi_created_by_user_id_2c")
  @@index([patientId, clinicId], map: "fk_1gdvi_patient_id_2c")
  @@index([treatmentPlanId, clinicId], map: "fk_1gdvi_treatment_plan_id_2c")
  @@map("treatment_financial_entries")
}

model TreatmentEstimate {
  id                          String                   @id @default(uuid()) @db.Uuid
  clinicId                    String                   @db.Uuid
  patientId                   String                   @db.Uuid
  treatmentPlanId             String                   @db.Uuid
  createdByUserId             String                   @db.Uuid
  revisionOfEstimateId        String?                  @db.Uuid
  revisionReason              String?                  @db.VarChar(1000)
  version                     Int                      @default(1)
  status                      TreatmentEstimateStatus  @default(DRAFT)
  estimateDate                DateTime                 @db.Date
  validityDate                DateTime                 @db.Date
  currency                    String                   @default("INR") @db.VarChar(3)
  subtotal                    Decimal                  @db.Decimal(12, 2)
  discountAmount              Decimal                  @db.Decimal(12, 2)
  taxRate                     Decimal                  @db.Decimal(5, 2)
  taxAmount                   Decimal                  @db.Decimal(12, 2)
  totalAmount                 Decimal                  @db.Decimal(12, 2)
  notes                       String?                  @db.VarChar(4000)
  terms                       String?                  @db.VarChar(4000)
  clinicNameSnapshot          String                   @db.VarChar(160)
  clinicPhoneSnapshot         String?                  @db.VarChar(20)
  clinicEmailSnapshot         String?                  @db.VarChar(254)
  clinicAddressSnapshot       String?                  @db.VarChar(400)
  patientNameSnapshot         String                   @db.VarChar(160)
  patientPhoneSnapshot        String                   @db.VarChar(20)
  dentistNameSnapshot         String                   @db.VarChar(120)
  dentistRegistrationSnapshot String?                  @db.VarChar(100)
  finalizedAt                 DateTime?                @db.Timestamptz(6)
  createdAt                   DateTime                 @default(now()) @db.Timestamptz(6)
  clinic                      Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient                     Patient                  @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict)
  treatmentPlan               TreatmentPlan            @relation(fields: [treatmentPlanId, clinicId, patientId], references: [id, clinicId, patientId], onDelete: Restrict)
  createdBy                   ClinicMembership         @relation("TreatmentEstimateAuthor", fields: [createdByUserId, clinicId], references: [userId, clinicId], onDelete: Restrict)
  revisionOf                  TreatmentEstimate?       @relation("TreatmentEstimateRevisions", fields: [revisionOfEstimateId, clinicId, patientId, treatmentPlanId], references: [id, clinicId, patientId, treatmentPlanId], onDelete: Restrict)
  revisions                   TreatmentEstimate[]      @relation("TreatmentEstimateRevisions")
  lines                       TreatmentEstimateLine[]

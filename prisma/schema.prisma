  REJECTED
  CANCELLED
}

enum PreventiveRecallType {
  SIX_MONTH_CHECKUP
  CLEANING
  CUSTOM
}

enum PreventiveRecallStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}


enum InsurancePaymentKind {
  PATIENT_PAYMENT
  INSURER_PAYMENT
}

enum InsuranceActivityType {
  CLAIM_CREATED
  STATUS_CHANGED
  CLAIM_UPDATED
  FOLLOW_UP_SCHEDULED
  PREAUTH_CREATED
  PREAUTH_STATUS_CHANGED
  DOCUMENT_REQUIRED

enum InsuranceDocumentType {
  POLICY_COPY
  TREATMENT_ESTIMATE
  TREATMENT_PLAN
  CLAIM_FORM
  INVOICE
  PRESCRIPTION
  DIAGNOSTIC_REPORT
  DISCHARGE_SUMMARY
  OTHER

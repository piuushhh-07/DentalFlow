}

enum MessageLogStatus {
  OPENED_IN_WHATSAPP
  MANUALLY_RECORDED_SENT
  AUTOMATIC_SEND_PENDING
  SENT_AUTOMATICALLY
  AUTOMATIC_SEND_FAILED
